@page "/rapporter/{ReportId:guid}"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using VarPlats.Web.Photos
@inject IReportStore Store
@inject ReportActionCommands Actions
@inject ContentFlagCommands Flags
@inject ReportArchiveCommands Archives
@inject PointsCommands PointsCommands
@inject PointsOptions PointsSettings
@inject ReportingMode Mode
@inject PhotoOptions PhotoSettings
@inject PhotoUploadCommands PhotoUploads
@inject IPhotoReader Photos
@inject IJSRuntime JS
@inject ILogger<ReportDetails> Logger

<PageTitle>Rapport – Vår plats</PageTitle>
<main class="document">
    <p><a href="/">Tillbaka till kartan och rapportlistan</a></p>
    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    @if (status is not null)
    {
        <p role="status">@status</p>
    }
    @if (loading)
    {
        <h1>Rapport</h1>
        <p role="status">Hämtar rapporten…</p>
    }
    else if (report is null)
    {
        <h1>Rapporten finns inte</h1>
        @if (error is null)
        {
            <p>Rapporten finns inte eller är inte publicerad.</p>
        }
    }
    else
    {
        <h1>@report.Title</h1>
        <p>@CategoryName(report.Category) · @FormatTime(report.CreatedAt) UTC</p>
        <p><strong>Status:</strong> @ReportStatusText.Describe(report.Status, Mode.WorkflowEnabled)</p>
        @if (archive is not null)
        {
            <div class="archive-notice" role="note">
                <p><strong>Arkiverad rapport</strong> · @ArchiveText.Reason(archive.Reason) · @FormatTime(archive.ArchivedAt) UTC</p>
                @if (archive.Note is not null)
                {
                    <p class="action-description">@archive.Note</p>
                }
                <p class="small">Rapporten visas inte längre på kartan eller i listan och tar inte emot nya åtgärdsuppgifter.</p>
            </div>
        }
        <p class="action-description">@report.Description</p>
        @if (reportPhotoIds.Contains(report.Id))
        {
            <img class="report-photo" src="@($"/photos/reports/{report.Id}")" alt="Uppladdad bild till rapporten" />
        }
        <p>Latitud: @report.Latitude.ToString("0.######", CultureInfo.InvariantCulture) · Longitud: @report.Longitude.ToString("0.######", CultureInfo.InvariantCulture)</p>
        @if (archive is null)
        {
            <p><a href="@($"/?rapport={report.Id}")">Visa på kartan</a> · länken kan delas och visar bara rapportens plats.</p>
        }
        @if (canFlag)
        {
            @FlagControls(null, "Anmäl rapporten")
        }
        @if (canArchive)
        {
            <section class="archive-admin" aria-labelledby="archive-heading">
                <h2 id="archive-heading">Arkivering</h2>
                @if (archive is not null)
                {
                    <button type="button" class="text-button" disabled="@busy" @onclick="Restore">Återställ rapporten till kartan</button>
                }
                else if (!archiveFormOpen)
                {
                    <button type="button" class="text-button" disabled="@busy" @onclick="OpenArchive">Arkivera rapporten</button>
                }
                else
                {
                    <EditForm Model="archiveDraft" OnValidSubmit="Archive" FormName="report-archive" class="flag-form">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <label for="archive-reason">Anledning</label>
                        <InputSelect id="archive-reason" @bind-Value="archiveDraft.Reason">
                            @foreach (var reason in Enum.GetValues<ArchiveReason>())
                            {
                                <option value="@reason">@ArchiveText.Reason(reason)</option>
                            }
                        </InputSelect>
                        <label for="archive-note">Kommentar @(archiveDraft.Reason == ArchiveReason.Other ? "(krävs för Annat)" : "(frivillig, visas på rapportsidan)")</label>
                        <InputTextArea id="archive-note" @bind-Value="archiveDraft.Note" maxlength="@ReportArchiveDraft.NoteMaxLength" rows="3" />
                        <p class="small">Kommentaren är publik. Skriv inga personuppgifter.</p>
                        <button type="submit" class="text-button" disabled="@busy">@(busy ? "Arkiverar…" : "Arkivera")</button>
                        <button type="button" class="text-button" disabled="@busy" @onclick="() => archiveFormOpen = false">Avbryt</button>
                    </EditForm>
                }
                @if (archiveHistory.Count > 0)
                {
                    <details>
                        <summary>Arkivhistorik (@archiveHistory.Count)</summary>
                        <ul>
                            @foreach (var item in archiveHistory)
                            {
                                <li>@FormatTime(item.CreatedAt) UTC · @(item.Kind == ArchiveEventKind.Archived ? $"Arkiverad: {ArchiveText.Reason(item.Reason ?? ArchiveReason.Other)}" : "Återställd")@(item.Note is null ? "" : $" · {item.Note}")</li>
                            }
                        </ul>
                    </details>
                }
            </section>
        }
        <p class="small">Vår plats är inte en officiell kommunal felanmälan. Kontakta ansvarig aktör när det behövs.</p>

        <section aria-labelledby="actions-heading">
            <h2 id="actions-heading">Uppgivna åtgärder</h2>
            <p>Det här är uppgifter från konton, inte en kontroll av platsen. En bekräftelse betyder att ett annat konto instämmer; vi har inte verifierat en fysisk person eller arbetets säkerhet.</p>
            <p>Bekräfta bara uppgifter du själv kan stå för. Utsätt dig inte för fara för att kontrollera en plats.</p>
            @if (Mode.Points)
            {
                <div class="points-note" role="note">
                    <p><strong>@PointsText.SafetyNote</strong></p>
                    <p class="small">Den som gjort åtgärden får @PointsText.Points(PointsSettings.ConfirmedActionPoints) en gång när ett annat konto bekräftar den. Hjärtan visar uppskattning men ger inga poäng. @(PointsCommands.GiftsEnabled ? "Skickade poäng dras från givarens eget saldo." : "")</p>
                    @if (ownBalance is { } balance)
                    {
                        <p class="small">Ditt saldo: @PointsText.Points(balance) · <a href="/mina-poang">Mina poäng</a></p>
                    }
                </div>
            }
            @if (Mode.WorkflowEnabled)
            {
                <button type="button" class="text-button" disabled="@busy" @onclick="Refresh">Uppdatera åtgärder och status</button>
            }
            @if (!Mode.WorkflowEnabled)
            {
                <p>Åtgärdsuppgifter är dolda när funktionen är avstängd.</p>
            }
            else if (actionItems.Count == 0)
            {
                <p>Ingen åtgärd har uppgetts för rapporten ännu.</p>
            }
            else
            {
                <p class="small">Senaste 200 åtgärdsuppgifterna visas. Rapportens status grundas på alla aktuella uppgifter.</p>
                <ul class="report-list action-list">
                    @foreach (var action in actionItems)
                    {
                        <li>
                            <article>
                                <p><strong>@ConfirmationText(action.ConfirmationCount)</strong> · @FormatTime(action.CreatedAt) UTC</p>
                                @if (action.WithdrawnCount > 0)
                                {
                                    <p class="small">@WithdrawnText(action.WithdrawnCount)</p>
                                }
                                <p class="action-description">@action.Description</p>
                                @if (actionPhotoIds.Contains(action.Id))
                                {
                                    <img class="report-photo" src="@($"/photos/actions/{action.Id}")" alt="Uppladdad bild till åtgärdsuppgiften" loading="lazy" />
                                }
                                @if (action.IsOwnAction)
                                {
                                    <p class="small">Ditt konto kan inte bekräfta en egen uppgift.</p>
                                }
                                else if (action.HasConfirmed)
                                {
                                    <p class="small">Ditt konto har redan bekräftat uppgiften.</p>
                                    @if (canWithdraw && archive is not null)
                                    {
                                        <p class="small">Bekräftelser på arkiverade rapporter kan inte tas tillbaka.</p>
                                    }
                                    else if (canWithdraw && withdrawTarget == action.Id)
                                    {
                                        <div class="flag-form" role="group" aria-labelledby="@($"withdraw-{action.Id:N}")">
                                            <p id="@($"withdraw-{action.Id:N}")"><strong>Ta tillbaka din bekräftelse?</strong></p>
                                            <p class="small">Rapportens status räknas om utan din bekräftelse. Att den tagits tillbaka sparas i historiken och ditt konto kan inte bekräfta uppgiften igen.</p>
                                            <button type="button" class="text-button" disabled="@busy" @onclick="() => Withdraw(action.Id)">@(busy ? "Tar tillbaka…" : "Ja, ta tillbaka bekräftelsen")</button>
                                            <button type="button" class="text-button" disabled="@busy" @onclick="CloseWithdraw">Avbryt</button>
                                        </div>
                                    }
                                    else if (canWithdraw)
                                    {
                                        <button type="button" class="text-button" disabled="@busy" @onclick="() => OpenWithdraw(action.Id)">Ta tillbaka bekräftelse</button>
                                    }
                                }
                                else if (action.HasWithdrawn)
                                {
                                    <p class="small">Ditt konto har tagit tillbaka sin bekräftelse och kan inte bekräfta uppgiften igen.</p>
                                }
                                else if (canWrite)
                                {
                                    <button type="button" class="text-button" disabled="@busy" @onclick="() => Confirm(action.Id)">Bekräfta uppgiften</button>
                                }
                                @if (Mode.Points && appreciation.TryGetValue(action.Id, out var liked))
                                {
                                    <p class="small"><span aria-hidden="true">♥</span> @PointsText.Hearts(liked.Hearts) · @PointsText.Points(liked.Points) till åtgärden</p>
                                    @if (canUsePoints && !action.IsOwnAction && (archive is null || liked.ViewerHearted))
                                    {
                                        <button type="button" class="text-button" disabled="@busy" aria-pressed="@(liked.ViewerHearted ? "true" : "false")" @onclick="() => ToggleHeart(action.Id)">@(liked.ViewerHearted ? "Ta bort hjärta" : "Ge hjärta")</button>
                                    }
                                    @if (canUsePoints && PointsCommands.GiftsEnabled && !action.IsOwnAction && archive is null)
                                    {
                                        @GiftControls(action.Id)
                                    }
                                }
                                @if (canRemove)
                                {
                                    <button type="button" class="text-button" disabled="@busy" @onclick="() => Remove(action.Id)">Ta bort åtgärdsuppgiften</button>
                                }
                                @if (canFlag)
                                {
                                    @FlagControls(action.Id, "Anmäl åtgärdstexten")
                                }
                            </article>
                        </li>
                    }
                </ul>
            }
        </section>

        @if (canWrite && archive is not null)
        {
            <p>Arkiverade rapporter tar inte emot nya åtgärdsuppgifter.</p>
        }
        else if (canWrite)
        {
            <section aria-labelledby="document-action-heading">
                <h2 id="document-action-heading">Uppge en åtgärd</h2>
                <p>Beskriv något som gjorts, till exempel städats eller åtgärdats. När du väljer att publicera visas texten direkt och utan förhandsgranskning. Den är obekräftad tills ett annat konto bekräftar den.</p>
                <p>Utsätt inte dig själv eller andra för fara. Rör inte elinstallationer, trafikmiljö, kemikalier, sprutor eller okänt avfall. Kontakta ansvarig aktör; ring 112 vid akut fara.</p>
                <p>Skriv inga namn, adresser, registreringsnummer eller andra personuppgifter. Texten kan finnas kvar även om du tar bort kontot.</p>
                <EditForm Model="draft" OnValidSubmit="Save" FormName="report-action">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <label for="action-description">Vad har gjorts?</label>
                    <InputTextArea id="action-description" @bind-Value="draft.Description" maxlength="1000" rows="5" />
                    <p class="small">10–1000 tecken. Bekräftelse från ett annat konto är ingen garanti för säkerhet.</p>
                    @if (PhotoSettings.Enabled)
                    {
                        <p>En vald bild visas direkt tillsammans med åtgärdsuppgiften.</p>
                        <PhotoUploadField @key="photoFieldVersion" Id="action-photo" Disabled="busy" SelectionChanged="SetPhoto" />
                    }
                    <RadzenButton ButtonType="ButtonType.Submit" Text="@(busy ? "Sparar…" : "Publicera åtgärdsuppgift")" Disabled="@busy" />
                </EditForm>
            </section>
        }
        else if (Mode.PublicWorkflow)
        {
            <p>Logga in med ett behörigt medlems- eller administratörskonto för att uppge eller bekräfta en åtgärd. Återställningsläget kan inte skriva.</p>
        }
        else if (Mode.WorkflowEnabled)
        {
            <p>Det går inte att uppge eller bekräfta åtgärder när skrivningar är avstängda.</p>
        }
    }
</main>

@code {
    [Parameter] public Guid ReportId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private Report? report;
    private IReadOnlyList<ReportAction> actionItems = [];
    private ReportActionDraft draft = new();
    private PhotoSelection photoSelection = new(null, false);
    private IReadOnlySet<Guid> reportPhotoIds = new HashSet<Guid>(), actionPhotoIds = new HashSet<Guid>();
    private Guid? loadedReportId;
    private int photoFieldVersion;
    private bool canWrite, canRemove, canFlag, canArchive, canWithdraw, canUsePoints, archiveFormOpen, loading = true, busy;
    // Which action has its withdrawal confirm step open.
    private Guid? withdrawTarget;
    private IReadOnlyDictionary<Guid, ActionAppreciation> appreciation = new Dictionary<Guid, ActionAppreciation>();
    private int? ownBalance;
    // Gift dialog: which action it is open for, and whether the confirm step is showing.
    private Guid? giftTarget;
    private bool giftConfirming;
    private PointsGiftDraft giftDraft = new();
    private ReportArchive? archive;
    private ReportArchiveDraft archiveDraft = new();
    private IReadOnlyList<ReportArchiveEvent> archiveHistory = [];
    // Which item has its flag form open: null = none, Guid.Empty = the report itself, otherwise an action id.
    private Guid? flagTarget;
    private ContentFlagDraft flagDraft = new();
    private string? error, status;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedReportId != ReportId)
        {
            loadedReportId = ReportId;
            draft = new();
            photoSelection = new(null, false);
            photoFieldVersion++;
            flagTarget = null;
            withdrawTarget = null;
            archiveFormOpen = false;
            giftTarget = null;
        }
        var user = (await AuthenticationStateTask).User;
        canArchive = Mode.CanArchive && ReportCommands.CanModerate(user);
        canFlag = Mode.CanFlag && ReportCommands.CanReport(user);
        canWrite = Mode.PublicWorkflow && ReportCommands.CanReport(user);
        canWithdraw = Mode.CanWithdrawConfirmation && ReportCommands.CanReport(user);
        canRemove = Mode.PublicWorkflow && ReportCommands.CanModerate(user);
        canUsePoints = Mode.CanUsePoints && ReportCommands.CanReport(user);
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        error = null;
        try
        {
            report = await Store.GetAsync(ReportId);
            actionItems = report is null
                ? []
                : await Actions.ListAsync((await AuthenticationStateTask).User, ReportId);
            var viewer = (await AuthenticationStateTask).User;
            reportPhotoIds = report is null ? new HashSet<Guid>()
                : await Photos.VisibleReportIdsAsync(viewer, [report.Id]);
            actionPhotoIds = await Photos.VisibleActionIdsAsync(actionItems.Select(action => action.Id).ToArray());
            archive = report is null ? null : await Archives.GetAsync(ReportId);
            archiveHistory = canArchive && report is not null
                ? await Archives.HistoryAsync(viewer, ReportId)
                : [];
            appreciation = await PointsCommands.ListForActionsAsync(viewer, actionItems.Select(action => action.Id).ToArray());
            ownBalance = await LoadBalance(viewer);
        }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(exception, "Rapporten eller åtgärdsuppgifterna kunde inte hämtas.");
            report = null;
            actionItems = [];
            reportPhotoIds = new HashSet<Guid>();
            actionPhotoIds = new HashSet<Guid>();
            archive = null;
            archiveHistory = [];
            appreciation = new Dictionary<Guid, ActionAppreciation>();
            ownBalance = null;
            error = "Rapporten kunde inte hämtas. Försök igen senare.";
        }
        finally { loading = false; }
    }

    private async Task Refresh()
    {
        if (busy) return;
        busy = true;
        status = null;
        try { await Reload(); }
        finally { busy = false; }
    }

    private async Task Save()
    {
        if (busy) return;
        if (photoSelection.Invalid)
        {
            error = "Välj en giltig bild eller ta bort bildvalet innan du publicerar åtgärdsuppgiften.";
            return;
        }
        busy = true;
        error = null;
        status = null;
        try
        {
            var user = (await AuthenticationStateTask).User;
            bool added;
            if (photoSelection.File is { } file)
            {
                await using var input = file.OpenReadStream(PhotoSanitizer.MaximumInputBytes);
                added = await PhotoUploads.SubmitActionAsync(user, ReportId, draft, input);
            }
            else
                added = await Actions.AddAsync(user, ReportId, draft);
            if (added)
            {
                draft = new();
                photoSelection = new(null, false);
                photoFieldVersion++;
            }
            await Reload();
            status = added ? "Åtgärdsuppgiften är publicerad."
                : "Rapporten finns inte längre eller är inte publicerad.";
        }
        catch (ValidationException exception) { error = exception.Message; }
        catch (UnauthorizedAccessException) { error = "Ett behörigt konto krävs för att uppge en åtgärd."; }
        catch (WriteRateLimitException exception) { error = exception.Message; }
        catch (PhotoUploadException exception) { error = exception.Message; }
        catch (PhotoSanitizationException exception)
        {
            error = $"{exception.Message} Ingen text eller bild sparades.";
        }
        catch (IOException exception)
        {
            Logger.LogWarning(exception, "Åtgärdsbilden kunde inte hanteras.");
            error = "Bilden kunde inte hanteras. Kontrollera åtgärdslistan innan du försöker igen.";
        }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(exception, "Åtgärdsuppgiften kunde inte sparas.");
            error = "Åtgärdsuppgiften kunde inte sparas. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private async Task Confirm(Guid actionId)
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            var user = (await AuthenticationStateTask).User;
            var result = await Actions.ConfirmAsync(user, ReportId, actionId);
            await Reload();
            status = result switch
            {
                ActionConfirmationResult.Confirmed => "Ditt konto har bekräftat uppgiften.",
                ActionConfirmationResult.AlreadyConfirmed => "Ditt konto har redan bekräftat uppgiften.",
                ActionConfirmationResult.OwnAction => "Ditt konto kan inte bekräfta en egen uppgift.",
                ActionConfirmationResult.Withdrawn => "Ditt konto har tagit tillbaka sin bekräftelse och kan inte bekräfta uppgiften igen.",
                _ => "Åtgärdsuppgiften finns inte längre."
            };
        }
        catch (UnauthorizedAccessException) { error = "Ett behörigt konto krävs för att bekräfta."; }
        catch (WriteRateLimitException exception) { error = exception.Message; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(exception, "Åtgärdsuppgiften kunde inte bekräftas.");
            error = "Bekräftelsen kunde inte sparas. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private void OpenWithdraw(Guid actionId)
    {
        withdrawTarget = actionId;
        status = null;
        error = null;
    }

    private void CloseWithdraw() => withdrawTarget = null;

    private async Task Withdraw(Guid actionId)
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            var user = (await AuthenticationStateTask).User;
            var result = await Actions.WithdrawConfirmationAsync(user, ReportId, actionId);
            withdrawTarget = null;
            await Reload();
            status = result switch
            {
                ConfirmationWithdrawalResult.Withdrawn => "Din bekräftelse är tillbakatagen. Rapportens status har räknats om.",
                ConfirmationWithdrawalResult.NotConfirmed => "Ditt konto har ingen aktiv bekräftelse på uppgiften.",
                ConfirmationWithdrawalResult.Archived => "Rapporten är arkiverad. Bekräftelsen kan inte tas tillbaka.",
                _ => "Åtgärdsuppgiften finns inte längre."
            };
        }
        catch (UnauthorizedAccessException) { error = "Ett behörigt konto krävs för att ta tillbaka en bekräftelse."; }
        catch (WriteRateLimitException exception) { error = exception.Message; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(exception, "Bekräftelsen kunde inte tas tillbaka.");
            error = "Bekräftelsen kunde inte tas tillbaka. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private async Task Remove(Guid actionId)
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            if (!await JS.InvokeAsync<bool>("confirm", "Ta bort åtgärdsuppgiften och dess bekräftelser permanent?"))
                return;
            var user = (await AuthenticationStateTask).User;
            var removed = await Actions.RemoveAsync(user, ReportId, actionId);
            await Reload();
            status = removed ? "Åtgärdsuppgiften och dess bekräftelser har tagits bort."
                : "Åtgärdsuppgiften finns inte längre.";
        }
        catch (UnauthorizedAccessException) { error = "Endast administratörer kan ta bort åtgärdsuppgifter."; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException or JSException)
        {
            Logger.LogError(exception, "Åtgärdsuppgiften kunde inte tas bort.");
            error = "Åtgärdsuppgiften kunde inte tas bort. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private RenderFragment FlagControls(Guid? actionId, string buttonText) => __builder =>
    {
        var target = actionId ?? Guid.Empty;
        var formId = $"flag-{target:N}";
        if (flagTarget != target)
        {
            <button type="button" class="text-button" disabled="@busy" @onclick="() => OpenFlag(target)">@buttonText</button>
            return;
        }
        <EditForm Model="flagDraft" OnValidSubmit="() => SubmitFlag(actionId)" FormName="@formId" class="flag-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <label for="@($"{formId}-reason")">Vad är fel?</label>
            <InputSelect id="@($"{formId}-reason")" @bind-Value="flagDraft.Reason">
                @foreach (var reason in Enum.GetValues<FlagReason>())
                {
                    <option value="@reason">@ContentFlagText.Reason(reason)</option>
                }
            </InputSelect>
            <label for="@($"{formId}-note")">Kommentar @(flagDraft.Reason == FlagReason.Other ? "(krävs för Annat)" : "(frivillig)")</label>
            <InputTextArea id="@($"{formId}-note")" @bind-Value="flagDraft.Note" maxlength="@ContentFlagLimits.NoteMaxLength" rows="3" />
            <p class="small">Skriv inga personuppgifter i kommentaren. Administratörer ser anmälan men inte vilket konto som skickade den.</p>
            <button type="submit" class="text-button" disabled="@busy">@(busy ? "Skickar…" : "Skicka anmälan")</button>
            <button type="button" class="text-button" disabled="@busy" @onclick="CloseFlag">Avbryt</button>
        </EditForm>
    };

    private void OpenFlag(Guid target)
    {
        flagTarget = target;
        flagDraft = new();
        status = null;
        error = null;
    }

    private void CloseFlag() => flagTarget = null;

    private async Task SubmitFlag(Guid? actionId)
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            var user = (await AuthenticationStateTask).User;
            var result = await Flags.FlagAsync(user, ReportId, actionId, flagDraft);
            flagTarget = null;
            flagDraft = new();
            status = ContentFlagText.Result(result);
            if (result == FlagResult.NotFound) await Reload();
        }
        catch (ValidationException exception) { error = exception.Message; }
        catch (UnauthorizedAccessException) { error = "Ett behörigt konto krävs för att anmäla innehåll."; }
        catch (WriteRateLimitException exception) { error = exception.Message; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(exception, "Anmälan kunde inte sparas.");
            error = "Anmälan kunde inte skickas. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private void OpenArchive()
    {
        archiveDraft = new();
        archiveFormOpen = true;
        status = null;
        error = null;
    }

    private async Task Archive()
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            var archived = await Archives.ArchiveAsync((await AuthenticationStateTask).User, ReportId, archiveDraft);
            archiveFormOpen = false;
            await Reload();
            status = archived ? "Rapporten är arkiverad och visas inte längre på kartan."
                : "Rapporten var redan arkiverad eller finns inte längre.";
        }
        catch (ValidationException exception) { error = exception.Message; }
        catch (UnauthorizedAccessException) { error = "Endast administratörer kan arkivera rapporter."; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(exception, "Rapporten kunde inte arkiveras.");
            error = "Rapporten kunde inte arkiveras. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private async Task Restore()
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            if (!await JS.InvokeAsync<bool>("confirm", "Återställ rapporten så att den visas på kartan och i listan igen?"))
                return;
            var restored = await Archives.RestoreAsync((await AuthenticationStateTask).User, ReportId);
            await Reload();
            status = restored ? "Rapporten är återställd och visas på kartan igen."
                : "Rapporten var inte arkiverad. Sidan har uppdaterats.";
        }
        catch (UnauthorizedAccessException) { error = "Endast administratörer kan återställa rapporter."; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException or JSException)
        {
            Logger.LogError(exception, "Rapporten kunde inte återställas.");
            error = "Rapporten kunde inte återställas. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private async Task<int?> LoadBalance(System.Security.Claims.ClaimsPrincipal viewer)
    {
        if (!canUsePoints) return null;
        try { return (await PointsCommands.GetOwnAsync(viewer)).Balance; }
        catch (UnauthorizedAccessException) { return null; }
    }

    private async Task ToggleHeart(Guid actionId)
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            var result = await PointsCommands.ToggleHeartAsync((await AuthenticationStateTask).User, ReportId, actionId);
            await Reload();
            status = PointsText.Heart(result);
        }
        catch (UnauthorizedAccessException) { error = "Ett behörigt konto krävs för att ge hjärtan."; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(exception, "Hjärtat kunde inte sparas.");
            error = "Hjärtat kunde inte sparas. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private RenderFragment GiftControls(Guid actionId) => __builder =>
    {
        var formId = $"gift-{actionId:N}";
        if (giftTarget != actionId)
        {
            <button type="button" class="text-button" disabled="@busy" @onclick="() => OpenGift(actionId)">Skicka poäng</button>
            return;
        }
        if (giftConfirming)
        {
            <div class="flag-form" role="group" aria-labelledby="@($"{formId}-confirm")">
                <p id="@($"{formId}-confirm")"><strong>Skicka @PointsText.Points(giftDraft.Amount) till kontot som gjorde åtgärden?</strong></p>
                <p class="small">Poängen dras från ditt saldo@(ownBalance is { } balance ? $" ({PointsText.Points(balance)})" : "") och kan inte ångras. Mottagaren ser inte vilket konto som skickade dem.</p>
                <button type="button" class="text-button" disabled="@busy" @onclick="() => SendGift(actionId)">@(busy ? "Skickar…" : "Ja, skicka poäng")</button>
                <button type="button" class="text-button" disabled="@busy" @onclick="() => giftConfirming = false">Ändra antal</button>
                <button type="button" class="text-button" disabled="@busy" @onclick="CloseGift">Avbryt</button>
            </div>
            return;
        }
        <EditForm Model="giftDraft" OnValidSubmit="ReviewGift" FormName="@formId" class="flag-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <label for="@($"{formId}-amount")">Antal poäng att skicka (1–@PointsSettings.MaxGiftPerTransfer)</label>
            <InputNumber id="@($"{formId}-amount")" @bind-Value="giftDraft.Amount" min="1" max="@PointsSettings.MaxGiftPerTransfer" />
            <p class="small">Poängen flyttas från ditt eget saldo; inga nya poäng skapas. Högst @PointsText.Points(PointsSettings.MaxGiftPerDay) per dygn. @PointsText.SafetyNote</p>
            <button type="submit" class="text-button" disabled="@busy">Fortsätt</button>
            <button type="button" class="text-button" disabled="@busy" @onclick="CloseGift">Avbryt</button>
        </EditForm>
    };

    private void OpenGift(Guid actionId)
    {
        giftTarget = actionId;
        giftConfirming = false;
        giftDraft = new();
        status = null;
        error = null;
    }

    private void CloseGift()
    {
        giftTarget = null;
        giftConfirming = false;
    }

    private void ReviewGift()
    {
        error = null;
        try
        {
            giftDraft.Validated(PointsSettings);
            giftConfirming = true;
        }
        catch (ValidationException exception) { error = exception.Message; }
    }

    private async Task SendGift(Guid actionId)
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            var amount = giftDraft.Amount;
            var result = await PointsCommands.GiftAsync((await AuthenticationStateTask).User, ReportId, actionId, giftDraft);
            CloseGift();
            await Reload();
            status = PointsText.Gift(result, amount);
        }
        catch (ValidationException exception)
        {
            error = exception.Message;
            giftConfirming = false;
        }
        catch (UnauthorizedAccessException) { error = "Ett behörigt konto krävs för att skicka poäng."; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(exception, "Poängen kunde inte skickas.");
            error = "Poängen kunde inte skickas. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private static string ConfirmationText(int count) => count switch
    {
        0 => "Uppgiven åtgärd · obekräftad",
        1 => "Bekräftad av ett annat konto",
        _ => $"Bekräftad av {count} andra konton"
    };

    private static string WithdrawnText(int count) => count == 1
        ? "1 bekräftelse har tagits tillbaka"
        : $"{count} bekräftelser har tagits tillbaka";

    private void SetPhoto(PhotoSelection selection) => photoSelection = selection;

    private static string FormatTime(DateTimeOffset time)
        => time.ToUniversalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    private static string CategoryName(ReportCategory category) => category switch
    {
        ReportCategory.Litter => "Skräp", ReportCategory.Broken => "Trasigt", _ => "Annat"
    };
}
