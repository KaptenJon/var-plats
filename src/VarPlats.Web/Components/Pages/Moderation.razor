@page "/moderering"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using VarPlats.Web.Photos
@using VarPlats.Web.Data
@inject ReportCommands Commands
@inject ReportActionCommands Actions
@inject ContentFlagCommands Flags
@inject ReportArchiveCommands Archives
@inject ReportingMode Mode
@inject IPhotoReader Photos
@inject IJSRuntime JS
@inject ILogger<Moderation> Logger

<PageTitle>Granskningskö – Vår plats</PageTitle>
<main class="document">
    <h1>Granskningskö</h1>
    @if (!Mode.WorkflowEnabled)
    {
        <p>Rapportgranskning är inte aktiverad i den här miljön.</p>
    }
    else if (!allowed)
    {
        <p>Endast administratörer utanför återställningsläget kan visa granskningskön.</p>
    }
    else
    {
        <p>Rapporter visas offentligt först efter godkännande. Granska innehåll och plats, även om rapportören har ombetts att inte ange personuppgifter.</p>
        @if (!Mode.PublicWorkflow)
        {
            <p>Granskningskön är tillgänglig för läsning, men ändringar är avstängda.</p>
        }
        @if (error is not null)
        {
            <p class="error" role="alert">@error</p>
        }
        @if (status is not null)
        {
            <p role="status">@status</p>
        }
        @if (loading)
        {
            <p role="status">Hämtar rapporter för granskning…</p>
        }
        else if (submissions.Count == 0 && error is null)
        {
            <p>Inga rapporter väntar på granskning.</p>
        }
        else
        {
            <p>Äldsta först · högst 200 rapporter åt gången</p>
            <ul class="report-list">
                @foreach (var submission in submissions)
                {
                    var report = submission.Report;
                    <li>
                        <article style="overflow-wrap: anywhere">
                            <h2>@report.Title</h2>
                            <p>@CategoryName(report.Category) · @report.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</p>
                            <p>@report.Description</p>
                            @if (reportPhotoIds.Contains(report.Id))
                            {
                                <img class="report-photo" src="@($"/photos/reports/{report.Id}")" alt="Uppladdad bild att granska" loading="lazy" />
                            }
                            <p>Latitud: @report.Latitude.ToString("0.######", CultureInfo.InvariantCulture) · Longitud: @report.Longitude.ToString("0.######", CultureInfo.InvariantCulture)</p>
                            @if (Mode.PublicWorkflow)
                            {
                                <button type="button" class="text-button" disabled="@busy" @onclick="() => Decide(report.Id, ReportReviewStatus.Approved)">Godkänn och publicera</button>
                                <button type="button" class="text-button" disabled="@busy" @onclick="() => Decide(report.Id, ReportReviewStatus.Rejected)">Avvisa</button>
                            }
                        </article>
                    </li>
                }
            </ul>
        }
        <button type="button" class="text-button" disabled="@busy" @onclick="Reload">Uppdatera kön</button>

        @if (Mode.FlagQueue)
        {
            <section aria-labelledby="flags-heading">
                <h2 id="flags-heading">Anmält innehåll</h2>
                <p>Publicerade rapporter och åtgärdstexter som konton har anmält. Vem som anmält visas inte. Ta bort innehållet om det bryter mot reglerna, annars avfärdar du anmälningarna.</p>
                @if (!Mode.CanFlag)
                {
                    <p>Anmälningar kan läsas, men ändringar är avstängda.</p>
                }
                @if (flagError is not null)
                {
                    <p class="error" role="alert">@flagError</p>
                }
                @if (flagsLoading)
                {
                    <p role="status">Hämtar anmälningar…</p>
                }
                else if (flagged.Count == 0 && flagError is null)
                {
                    <p>Inga öppna anmälningar.</p>
                }
                else
                {
                    <p>Äldsta anmälan först · högst @ContentFlagLimits.QueueSize objekt åt gången</p>
                    <ul class="report-list">
                        @foreach (var item in flagged)
                        {
                            <li @key="(item.ReportId, item.ActionId)">
                                <article style="overflow-wrap: anywhere">
                                    <h3>@(item.ActionId is null ? "Rapport" : "Åtgärdstext") · @item.ReportTitle</h3>
                                    <p>@FlagCountText(item.FlagCount) · första @item.FirstFlaggedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</p>
                                    <p class="action-description">@item.Text</p>
                                    <p><strong>Anledningar:</strong> @string.Join("; ", item.Reasons.Select(ContentFlagText.Reason))</p>
                                    @if (item.Notes.Count > 0)
                                    {
                                        <p><strong>Kommentarer:</strong></p>
                                        <ul>
                                            @foreach (var note in item.Notes)
                                            {
                                                <li class="action-description">@note</li>
                                            }
                                        </ul>
                                    }
                                    <p><a href="@($"/rapporter/{item.ReportId}")">Visa rapporten</a></p>
                                    @if (Mode.CanFlag)
                                    {
                                        <button type="button" class="text-button" disabled="@busy" @onclick="() => RemoveFlagged(item)">@(item.ActionId is null ? "Ta bort rapporten" : "Ta bort åtgärdstexten")</button>
                                        <button type="button" class="text-button" disabled="@busy" @onclick="() => Dismiss(item)">Avfärda anmälningarna</button>
                                    }
                                </article>
                            </li>
                        }
                    </ul>
                }
            </section>
        }

        @if (Mode.Archive)
        {
            <section aria-labelledby="archive-heading">
                <h2 id="archive-heading">Arkiverade rapporter</h2>
                <p>Arkiverade rapporter visas inte på kartan, i listan eller i läs-API:t. Öppna rapporten för att återställa den.</p>
                @if (archiveError is not null)
                {
                    <p class="error" role="alert">@archiveError</p>
                }
                else if (archived.Count == 0)
                {
                    <p>Inga arkiverade rapporter.</p>
                }
                else
                {
                    <p>Senast arkiverade först · högst 200</p>
                    <ul>
                        @foreach (var item in archived)
                        {
                            <li @key="item.ReportId"><a href="@($"/rapporter/{item.ReportId}")">@item.Title</a> · @ArchiveText.Reason(item.Reason) · @item.ArchivedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC</li>
                        }
                    </ul>
                }
            </section>
        }
    }
    <p><a href="/">Tillbaka till kartan</a></p>
</main>

@code {
    private IReadOnlyList<ReportSubmission> submissions = [];
    private IReadOnlySet<Guid> reportPhotoIds = new HashSet<Guid>();
    private IReadOnlyList<FlaggedContent> flagged = [];
    private IReadOnlyList<ArchivedReport> archived = [];
    private string? archiveError;
    private bool allowed, loading, busy, flagsLoading;
    private string? error, status, flagError;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        allowed = ReportCommands.CanModerate((await AuthenticationStateTask).User);
        if (Mode.WorkflowEnabled && allowed)
            await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        error = null;
        try
        {
            var user = (await AuthenticationStateTask).User;
            submissions = await Commands.ListPendingAsync(user);
            reportPhotoIds = await Photos.VisibleReportIdsAsync(
                user, submissions.Select(submission => submission.Report.Id).ToArray());
        }
        catch (UnauthorizedAccessException)
        {
            submissions = [];
            reportPhotoIds = new HashSet<Guid>();
            error = "Du har inte behörighet att visa granskningskön.";
        }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            Logger.LogError(exception, "Granskningskön kunde inte hämtas.");
            submissions = [];
            reportPhotoIds = new HashSet<Guid>();
            error = "Granskningskön kunde inte hämtas. Försök igen senare.";
        }
        finally { loading = false; }
        await ReloadFlags();
        await ReloadArchive();
    }

    private async Task ReloadArchive()
    {
        if (!Mode.Archive) return;
        archiveError = null;
        try { archived = await Archives.ListAsync((await AuthenticationStateTask).User); }
        catch (UnauthorizedAccessException)
        {
            archived = [];
            archiveError = "Du har inte behörighet att visa arkiverade rapporter.";
        }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or InvalidOperationException)
        {
            Logger.LogError(exception, "Arkiverade rapporter kunde inte hämtas.");
            archived = [];
            archiveError = "Arkiverade rapporter kunde inte hämtas. Kontrollera att migrationen ReportArchive är tillämpad.";
        }
    }

    // Separate from the submission queue so a missing flags table cannot hide pending submissions.
    private async Task ReloadFlags()
    {
        if (!Mode.FlagQueue) return;
        flagsLoading = true;
        flagError = null;
        try { flagged = await Flags.ListOpenAsync((await AuthenticationStateTask).User); }
        catch (UnauthorizedAccessException)
        {
            flagged = [];
            flagError = "Du har inte behörighet att visa anmälningar.";
        }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or InvalidOperationException)
        {
            Logger.LogError(exception, "Anmälningar kunde inte hämtas.");
            flagged = [];
            flagError = "Anmälningar kunde inte hämtas. Kontrollera att migrationen ContentFlags är tillämpad.";
        }
        finally { flagsLoading = false; }
    }

    private async Task Dismiss(FlaggedContent item)
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            if (!await JS.InvokeAsync<bool>("confirm", "Avfärda anmälningarna? Innehållet ligger kvar och samma konton kan inte anmäla det igen."))
                return;
            var count = await Flags.DismissAsync((await AuthenticationStateTask).User, item.ReportId, item.ActionId);
            await ReloadFlags();
            status = count == 0 ? "Anmälningarna var redan hanterade. Listan har uppdaterats." : "Anmälningarna har avfärdats.";
        }
        catch (UnauthorizedAccessException) { error = "Endast administratörer kan hantera anmälningar."; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException or JSException)
        {
            Logger.LogError(exception, "Anmälningar kunde inte avfärdas.");
            error = "Anmälningarna kunde inte avfärdas. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private async Task RemoveFlagged(FlaggedContent item)
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            var question = item.ActionId is null
                ? "Ta bort rapporten permanent, med åtgärder, bekräftelser och anmälningar? Detta kan inte ångras."
                : "Ta bort åtgärdstexten permanent, med bekräftelser och anmälningar? Detta kan inte ångras.";
            if (!await JS.InvokeAsync<bool>("confirm", question)) return;
            var user = (await AuthenticationStateTask).User;
            var removed = item.ActionId is { } actionId
                ? await Actions.RemoveAsync(user, item.ReportId, actionId)
                : await Commands.RemoveAsync(user, item.ReportId);
            await ReloadFlags();
            status = removed ? "Innehållet har tagits bort." : "Innehållet fanns inte längre. Listan har uppdaterats.";
        }
        catch (UnauthorizedAccessException) { error = "Endast administratörer kan ta bort innehåll."; }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException or JSException)
        {
            Logger.LogError(exception, "Anmält innehåll kunde inte tas bort.");
            error = "Innehållet kunde inte tas bort. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private static string FlagCountText(int count) => count == 1 ? "1 anmälan" : $"{count} anmälningar";

    private async Task Decide(Guid id, ReportReviewStatus decision)
    {
        if (busy) return;
        busy = true;
        error = null;
        status = null;
        try
        {
            var question = decision == ReportReviewStatus.Approved
                ? "Godkänn och publicera rapporten?"
                : "Avvisa rapporten? Den kommer inte att visas offentligt.";
            if (!await JS.InvokeAsync<bool>("confirm", question)) return;
            var user = (await AuthenticationStateTask).User;
            var changed = await Commands.DecideAsync(user, id, decision);
            await Reload();
            status = !changed ? "Rapporten har redan granskats eller finns inte längre. Kön har uppdaterats."
                : decision == ReportReviewStatus.Approved ? "Rapporten är godkänd och publicerad."
                : "Rapporten har avvisats och visas inte offentligt.";
        }
        catch (UnauthorizedAccessException)
        {
            error = "Du har inte behörighet att granska rapporter.";
        }
        catch (PhotoReviewException exception)
        {
            error = exception.Message;
        }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException or JSException)
        {
            Logger.LogError(exception, "Rapporten kunde inte granskas.");
            error = "Rapporten kunde inte granskas. Försök igen senare.";
        }
        finally { busy = false; }
    }

    private static string CategoryName(ReportCategory category) => category switch
    {
        ReportCategory.Litter => "Skräp", ReportCategory.Broken => "Trasigt", _ => "Annat"
    };
}
