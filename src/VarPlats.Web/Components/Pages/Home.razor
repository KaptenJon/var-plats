@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using VarPlats.Web.Photos
@inject IReportStore Store
@inject ReportCommands Commands
@inject ReportingMode Mode
@inject PhotoOptions PhotoSettings
@inject PhotoUploadCommands PhotoUploads
@inject Microsoft.Extensions.Options.IOptions<MapOptions> MapSettings
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<PageTitle>Vår plats – upptäck, dokumentera, förbättra</PageTitle>
<!-- THESIS: Platsen är arbetsytan, inte en dashboard. OWN-WORLD: Vit fältyta, skogsgrön orientering, raka listor.
STORY: Se exempel, välj plats, dokumentera en observation. FIRST VIEWPORT: Verktygsrad över stor karta och läsbar sidolista.
FORM: Orienteringskontrollens fältblad, riktning 4; d33d31b5. Ingen påhittad effekt eller poäng. -->
<a class="skip-link" href="#reports">Hoppa till rapporterna</a>
<header class="topbar">
    <a class="brand" href="/" aria-label="Vår plats, startsida"><span class="brand-mark" aria-hidden="true">⌖</span> Vår plats<span class="prototype">Prototyp</span></a>
    <a href="/om">Om tjänsten</a>
    <AuthorizeView>
        <Authorized>
            <form action="/auth/logout" method="post">
                <AntiforgeryToken />
                <button class="text-button" type="submit">Logga ut</button>
            </form>
        </Authorized>
        <NotAuthorized><a href="/login">Logga in</a></NotAuthorized>
    </AuthorizeView>
</header>
<main>
    <section class="workspace-heading" aria-labelledby="page-title">
        <div><h1 id="page-title">En bättre plats börjar här.</h1><p>Upptäck det som behöver omsorg i vår gemensamma miljö.</p></div>
        @if (canReport)
        {
            <RadzenButton Text="Rapportera en plats" Icon="add_location_alt" Click="@OpenForm" />
        }
    </section>
    <div class="mode-notice" role="status">
        @if (Mode.Demo)
        {
            <strong>Lokal demo</strong><span>Påhittade exempel. Dina rapporter finns bara i den här anslutningen och försvinner när den avslutas.</span>
        }
        else if (Mode.LocalWrites)
        {
            <strong>Lokal utveckling</strong><span>Rapporter sparas i din utvecklingsdatabas. Använd inga personuppgifter.</span>
        }
        else if (Mode.PublicWorkflow)
        {
            <strong>Rapportering med granskning</strong><span>Rapporter visas offentligt först efter godkännande. Åtgärdsuppgifter på publicerade rapporter visas direkt.</span>
        }
        else if (Mode.WorkflowEnabled)
        {
            <strong>Förhandsversion · endast läsning</strong><span>Rapporter och åtgärdsuppgifter kan läsas, men nya inskick och bekräftelser är avstängda.</span>
        }
        else
        {
            <AuthorizeView>
                <Authorized>
                    <strong>Förhandsversion · endast läsning</strong><span>Du är inloggad. <a href="/account/connections">Hantera inloggningsmetoder</a>. Rapportering, åtgärder, bekräftelser och bevakning är fortfarande avstängda i förhandsversionen.</span>
                </Authorized>
                <NotAuthorized>
                    <strong>Förhandsversion · endast läsning</strong><span>Kontoinloggning kan användas för att hantera inloggningsmetoder. Rapportering, åtgärder, bekräftelser och bevakning är avstängda.</span>
                </NotAuthorized>
            </AuthorizeView>
        }
    </div>
    @if (Mode.PublicWorkflow && !canReport)
    {
        <p class="save-status">Logga in med ett behörigt konto för att rapportera. Återställningsläget kan inte skicka rapporter.</p>
    }
    <div class="workspace">
        <section class="map-panel" aria-label="Karta över rapporter">
            <div id="map" aria-label="Interaktiv karta. Rapporter finns också i listan." role="region"></div>
            <div class="map-caption">Stockholm · startområde, inte din position</div>
            @if (showForm)
            {
                <div class="map-instruction">Klicka på kartan för att placera din rapport, eller ange koordinater i formuläret.</div>
            }
        </section>
        <aside id="reports" class="report-panel" aria-label="Rapporter och rapportformulär">
            @if (canCheckOwn || canReview)
            {
                <nav aria-label="Rapporthantering">
                    @if (canCheckOwn) { <a href="/mina-rapporter">Mina rapporter</a> }
                    @if (canReview) { <span> · </span><a href="/moderering">Granskningskö</a> }
                </nav>
            }
            @if (error is not null)
            {
                <div class="error" role="alert">@error <button class="text-button" @onclick="Reload">Försök igen</button></div>
            }
            @if (showForm)
            {
                <div class="panel-heading"><h2>Vad har du sett?</h2><button class="text-button" @onclick="CloseForm">Avbryt</button></div>
                <p class="small">Beskriv platsen, inte personer. Lägg inte till namn, registreringsnummer eller kontaktuppgifter.</p>
                @if (Mode.PublicWorkflow)
                {
                    <p>Rapporten väntar på manuell granskning och publiceras först om den godkänns.</p>
                }
                <EditForm Model="draft" OnValidSubmit="Save" FormName="report">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <label for="title">Rubrik</label>
                    <InputText id="title" @bind-Value="draft.Title" maxlength="100" placeholder="Till exempel skräp vid gångvägen" />
                    <label for="category">Kategori</label>
                    <InputSelect id="category" @bind-Value="draft.Category">
                        <option value="@ReportCategory.Litter">Skräp</option>
                        <option value="@ReportCategory.Broken">Trasigt</option>
                        <option value="@ReportCategory.Other">Annat</option>
                    </InputSelect>
                    <label for="description">Beskrivning</label>
                    <InputTextArea id="description" @bind-Value="draft.Description" maxlength="1000" rows="4" />
                    <div class="coordinate-fields">
                        <div><label for="latitude">Latitud</label><InputNumber id="latitude" @bind-Value="draft.Latitude" step="any" /></div>
                        <div><label for="longitude">Longitud</label><InputNumber id="longitude" @bind-Value="draft.Longitude" step="any" /></div>
                    </div>
                    @if (Mode.PublicWorkflow && PhotoSettings.Enabled)
                    {
                        <PhotoUploadField Id="report-photo" Disabled="saving" SelectionChanged="SetPhoto" />
                    }
                    <p class="safety">Rör inte elinstallationer, trafikmiljö, kemikalier, sprutor eller okänt avfall. Vid akut fara: ring 112.</p>
                    <RadzenButton ButtonType="ButtonType.Submit" Text="@(saving ? "Sparar…" : Mode.Demo ? "Spara i lokal demo" : Mode.PublicWorkflow ? "Skicka till granskning" : "Spara i utvecklingsdatabas")" Disabled="saving" Style="width: 100%" />
                </EditForm>
            }
            else
            {
                <div class="panel-heading"><h2>Platser att uppmärksamma</h2><span class="count">@VisibleReports.Count</span></div>
                <p class="small">Senast rapporterade · högst 200 platser</p>
                <label for="search">Sök i rapporter</label>
                <input id="search" type="search" @bind="search" @bind:event="oninput" @bind:after="SyncMap" maxlength="100" placeholder="Sök rubrik eller beskrivning" />
                <label for="filter">Visa kategori</label>
                <select id="filter" @bind="filter" @bind:after="SyncMap">
                    <option value="">Alla kategorier</option><option value="Litter">Skräp</option><option value="Broken">Trasigt</option><option value="Other">Annat</option>
                </select>
                @if (loading)
                {
                    <p role="status">Hämtar rapporter…</p>
                }
                else if (reports.Count == 0)
                {
                    <p class="empty">Här finns inga rapporter att visa. @(canReport ? "Lägg till en första observation." : "Prova en annan kategori eller återkom senare.")</p>
                }
                else if (!VisibleReports.Any())
                {
                    <p class="empty">Inga rapporter matchar sökningen och valda kategorin. Prova andra sökord eller en annan kategori.</p>
                }
                else
                {
                    <ul class="report-list">
                        @foreach (var report in VisibleReports)
                        {
                            <li>
                                <button class="report-item @(selected == report.Id ? "selected" : "")" aria-pressed="@(selected == report.Id ? "true" : "false")" @onclick="() => Select(report)">
                                    <span class="report-symbol" aria-hidden="true">@(report.Category == ReportCategory.Litter ? "♧" : "◇")</span>
                                    <span><span class="report-category">@CategoryName(report.Category) · @ReportStatusText.Describe(report.Status, Mode.WorkflowEnabled)</span><strong>@report.Title</strong><span class="report-description">@report.Description</span></span>
                                </button>
                                <a class="report-details-link" href="@($"/rapporter/{report.Id}")" aria-label="@($"Visa rapport och åtgärder för {report.Title}")">Visa rapport och åtgärder</a>
                                @if (canModerate)
                                {
                                    <button class="text-button admin-remove" disabled="removing" @onclick="() => Remove(report)">Ta bort rapport</button>
                                }
                            </li>
                        }
                    </ul>
                }
                <div class="next-step"><h3>Från observation till omtanke</h3><p>@(Mode.WorkflowEnabled ? "Åtgärder och bekräftelser är uppgifter från konton, inte en kontroll av platsen eller arbetets säkerhet." : "Åtgärdsuppgifter och bekräftelser är avstängda i den här miljön.") Inga poäng delas ut.</p></div>
            }
            <p class="small official-note">Vår plats är inte en officiell kommunal felanmälan. Kontakta ansvarig aktör när det behövs.</p>
        </aside>
    </div>
    <p class="save-status" role="status">@status</p>
</main>
<footer><span>Gemensamma platser. Gemensam omtanke.</span><a href="/integritet">Integritet</a><a href="/villkor">Villkor</a><a href="https://www.openstreetmap.org/fixthemap">Rapportera kartfel</a></footer>
<div id="blazor-error-ui" role="alert">Anslutningen har avbrutits eller ett fel uppstod. <a href="/">Ladda om</a>. Osparad lokal demo kan försvinna.</div>

@code {
    private IReadOnlyList<Report> reports = [];
    private ReportDraft draft = new();
    private PhotoSelection photoSelection = new(null, false);
    private bool showForm, saving, loading = true;
    private bool canReport, canModerate, canCheckOwn, canReview, removing, initialized;
    private string? error, status;
    private string filter = "", search = "";
    private Guid? selected;
    private IJSObjectReference? module;
    private DotNetObjectReference<Home>? callback;
    private IReadOnlyList<Report> VisibleReports => ReportListFilter.Apply(reports, filter, search);

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthenticationStateTask).User;
        canReport = Mode.Demo || Mode.LocalWrites || (Mode.PublicWorkflow && ReportCommands.CanReport(user));
        canModerate = Mode.CanWrite && ReportCommands.CanModerate(user);
        canCheckOwn = Mode.WorkflowEnabled && ReportCommands.CanReport(user);
        canReview = Mode.WorkflowEnabled && ReportCommands.CanModerate(user);
        if (!initialized)
        {
            initialized = true;
            await LoadReports();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./map.js");
            callback = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("initialize", "map", MapSettings.Value, callback);
            await SyncMap();
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Kartan kunde inte startas.");
            error = "Kartan kunde inte laddas. Rapportlistan fungerar fortfarande. Ladda om sidan för att försöka igen.";
            StateHasChanged();
        }
    }

    private async Task LoadReports()
    {
        loading = true;
        error = null;
        try { reports = await Store.ListAsync(); }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or InvalidOperationException)
        {
            Logger.LogError(exception, "Rapporter kunde inte hämtas.");
            error = "Rapporter kunde inte hämtas. Kontrollera databasanslutningen och försök igen.";
        }
        finally { loading = false; }
    }

    private async Task Reload() { await LoadReports(); await SyncMap(); }
    private async Task SyncMap()
    {
        var visibleReports = VisibleReports;
        if (selected is Guid selectedId && !visibleReports.Any(report => report.Id == selectedId))
            selected = null;
        await InvokeMap("setReports", visibleReports);
    }
    private async Task InvokeMap(string method, params object?[] arguments)
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync(method, arguments); }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Kartkommandot {MapCommand} misslyckades.", method);
            error = "Kartan kunde inte uppdateras. Använd listan och koordinatfälten, eller ladda om sidan.";
        }
    }
    private async Task OpenForm()
    {
        if (!canReport) return;
        showForm = true;
        status = null;
        await InvokeMap("setPicking", true);
    }
    private async Task CloseForm()
    {
        showForm = false;
        photoSelection = new(null, false);
        await InvokeMap("setPicking", false);
    }
    private void SetPhoto(PhotoSelection selection) => photoSelection = selection;
    [JSInvokable]
    public Task TileLoadingFailed()
    {
        Logger.LogWarning("Kartleverantörens tiles kunde inte laddas.");
        error = "Kartbakgrunden kunde inte laddas. Rapportlistan och koordinatfälten fungerar fortfarande.";
        return InvokeAsync(StateHasChanged);
    }
    [JSInvokable]
    public Task PickLocation(double latitude, double longitude)
    {
        if (!showForm) return Task.CompletedTask;
        draft.Latitude = Math.Round(latitude, 6);
        draft.Longitude = Math.Round(longitude, 6);
        return InvokeAsync(StateHasChanged);
    }
    [JSInvokable]
    public Task SelectReportFromMap(Guid reportId)
    {
        var report = VisibleReports.FirstOrDefault(candidate => candidate.Id == reportId);
        if (report is null) return Task.CompletedTask;
        selected = reportId;
        status = $"Vald rapport: {report.Title}.";
        return InvokeAsync(StateHasChanged);
    }
    private async Task Select(Report report)
    {
        selected = report.Id;
        await InvokeMap("focusReport", report.Id, report.Latitude, report.Longitude);
    }
    private async Task Save()
    {
        if (!Mode.CanWrite || saving) return;
        if (photoSelection.Invalid)
        {
            error = "Välj en giltig bild eller ta bort bildvalet innan du skickar rapporten.";
            return;
        }
        saving = true;
        error = null;
        try
        {
            var user = (await AuthenticationStateTask).User;
            if (photoSelection.File is { } file)
            {
                await using var input = file.OpenReadStream(PhotoSanitizer.MaximumInputBytes);
                await PhotoUploads.SubmitReportAsync(user, draft, input);
            }
            else
                await Commands.AddAsync(user, draft);
            draft = new();
            filter = "";
            search = "";
            await CloseForm();
            await LoadReports();
            await SyncMap();
            status = Mode.Demo ? "Rapporten är sparad i din lokala demo, inte publicerad."
                : Mode.PublicWorkflow ? "Rapporten är skickad och väntar på granskning. Den visas offentligt först om den godkänns."
                : "Rapporten är sparad i din utvecklingsdatabas.";
        }
        catch (UnauthorizedAccessException)
        {
            error = "Logga in med ett behörigt konto innan du rapporterar.";
        }
        catch (PhotoUploadException exception) { error = exception.Message; }
        catch (PhotoSanitizationException exception)
        {
            error = $"{exception.Message} Ingen text eller bild sparades.";
        }
        catch (IOException exception)
        {
            Logger.LogWarning(exception, "Rapportbilden kunde inte hanteras.");
            error = "Bilden kunde inte hanteras. Kontrollera rapportens status innan du försöker igen.";
        }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException or ValidationException or InvalidOperationException)
        {
            Logger.LogError(exception, "Rapport kunde inte sparas.");
            error = "Rapporten kunde inte sparas. Kontrollera uppgifterna och databasanslutningen innan du försöker igen.";
        }
        finally { saving = false; }
    }
    private async Task Remove(Report report)
    {
        if (!canModerate || removing) return;
        status = null;
        error = null;
        try
        {
            if (!await JS.InvokeAsync<bool>("confirm", "Ta bort rapporten permanent? Detta kan inte ångras."))
                return;
            removing = true;
            var user = (await AuthenticationStateTask).User;
            if (!await Commands.RemoveAsync(user, report.Id))
            {
                error = "Rapporten finns inte längre. Listan har uppdaterats.";
                await LoadReports();
                await SyncMap();
                return;
            }
            if (selected == report.Id) selected = null;
            await LoadReports();
            await SyncMap();
            status = "Rapporten har tagits bort.";
        }
        catch (UnauthorizedAccessException)
        {
            error = "Endast administratörer kan ta bort rapporter.";
        }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            Logger.LogError(exception, "Rapport kunde inte tas bort.");
            error = "Rapporten kunde inte tas bort. Kontrollera databasanslutningen och försök igen.";
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Bekräftelse för borttagning kunde inte visas.");
            error = "Borttagningen kunde inte bekräftas. Försök igen.";
        }
        finally { removing = false; }
    }
    private static string CategoryName(ReportCategory category) => category switch
    {
        ReportCategory.Litter => "Skräp", ReportCategory.Broken => "Trasigt", _ => "Annat"
    };
    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("dispose"); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* Circuit already closed; no browser remains to clean up. */ }
        }
        callback?.Dispose();
    }
}
